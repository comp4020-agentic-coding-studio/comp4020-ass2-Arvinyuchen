---
// Uses BaseLayout rather than ContentLayout on purpose.
//
// ContentLayout renders the frontmatter description twice over: once as the
// <meta name="description"> and once as a visible lead paragraph under the
// title, with no way to keep the first without the second. A lecture page does
// not want a subtitle, it wants the date and how long the page takes to read.
// So the heading and the meta line are rendered here, and `description` goes
// to BaseLayout for search engines and the grid cards only.
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { withBase } from "astro-theme-university/url";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { readingMinutes } from "../../lib/reading-time";
import SiteChrome from "../../components/SiteChrome.astro";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const lectures = await getPublishedCollection("lectures");
  return lectures.map((lecture) => ({ params: { slug: lecture.id }, props: { lecture } }));
}

const { lecture } = Astro.props;
const { Content } = await render(lecture);
const title = `Week ${lecture.data.week}: ${lecture.data.title}`;
const minutes = readingMinutes(lecture.body ?? "");

// Matches the name ContentLayout derives, so the view transition from the
// lecture card on the index page still lands on this heading.
const transitionName = `card-title-${Astro.url.pathname.replace(/^\/|\/$/g, "").replace(/\//g, "-")}`;
---

<BaseLayout title={title} description={lecture.data.description ?? undefined} {...siteConfig}>
  <SiteChrome />
  <h1 transition:name={transitionName}>{title}</h1>

  <p class="page-meta">
    <span>{formatCourseDate(lecture.data.date)}</span>
    <span>{minutes} min read</span>
  </p>

  {
    lecture.data.slides && (
      <p class="lecture-slides">
        <a href={withBase(lecture.data.slides)}>Open the slides</a>
      </p>
    )
  }

  <Content />

  <div class="apparatus">
    <TeachingTeam teachers={lecture.data.teachers} />
    <RelatedContent entry={lecture} collections={graphCollections} />
  </div>
</BaseLayout>

<style>
  /* The metadata line under the title is .page-meta, in src/styles/site.css.
     It used to be defined here, and then a second time in the lab route, where
     it had already drifted into a bold date on a line of its own. Two routes
     render the same line, so one rule defines it. */
  .lecture-slides {
    margin-block: 0 var(--at-spacing-lg);
  }
</style>
