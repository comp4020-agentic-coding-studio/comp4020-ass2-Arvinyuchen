---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
import SiteChrome from "../../components/SiteChrome.astro";
---

<ContentLayout
  title={sessionLabels.plural}
  description="Twelve weeks, twelve methods, one day taken apart and rebuilt"
  {...siteConfig}
>
  <SiteChrome />
  <p>
    You arrive with a record of your own day and leave with a result about it,
    or, more often, with a reason the result cannot be trusted.
  </p>

  <p>
    These are twelve <em>methods</em>, not twelve topics, each introduced once
    and each depending on the ones before it. You cannot take something away
    and put it back before deciding what you are measuring, and you cannot see
    why your worst day improved until you have watched a whole class's worst
    days improve together.
  </p>

  <SessionsGrid />
</ContentLayout>
