---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
import SiteChrome from "../../components/SiteChrome.astro";
---

<ContentLayout
  title={sessionLabels.plural}
  description="Twelve weeks, twelve methods, one day taken apart and rebuilt"
  {...siteConfig}
>
  <SiteChrome />
  <p>
    You arrive with a record of your own day and leave with a result about it,
    or, more often, with a reason the result cannot be trusted.
  </p>

  <p>
    These are twelve <em>methods</em>, not twelve topics, each introduced once
    and each depending on the ones before it. They run in three moves:
    <strong>realisation</strong> in weeks 1 to 4, where you learn to see your
    own day accurately; <strong>change</strong> in 5 to 7, where you alter one
    thing and test it properly; and <strong>rethinking</strong> in 8 to 12,
    where you work out how much of the result was the change and how much was
    everything else.
  </p>

  <SessionsGrid />
</ContentLayout>
