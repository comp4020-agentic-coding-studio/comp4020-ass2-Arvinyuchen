---
// Eleven countries, marked by how much of a day one national document covers.
//
// The lecture closes by saying that we are in Australia, so three national
// documents are the place to start. This figure is the next question: what are
// the equivalents elsewhere, and do they come in the same shape? The mark
// answers one thing only, and it is the course's own premise turning up in
// national policy. Canada wrote a guideline that sets activity, sitting and
// sleep together across a whole twenty-four hours; Australia took that format;
// most of the rest publish activity guidelines with sleep left outside. That is
// the unit of design being argued over by health departments, which is why it
// earns the mark rather than decorating the map. A click-to-reveal map with
// grey countries would have been a menu in a figure's clothes, because then the
// geography would encode nothing at all and a plain list would do the same job
// better.
//
// One entry at a time, and the base state does it without scripting. The
// guidelines are a list of eleven <details>, each one individually operable,
// each headed by its number, its country and its category in words. Australia
// is the one left open, because the lecture's closing paragraph points at
// Australia's three documents and this figure is that paragraph carried
// outward. The map is eleven links into that list. With scripting off, every
// country's entry is still there and still opens; with scripting on, opening
// one closes the others and the map and the list agree about which one is
// showing.
//
// Labels are the hard part at eleven countries, and this is the third attempt.
// Visible names collided: Germany, France and the Netherlands sit 25 units
// apart in a frame 960 across, and the four European names together ran wider
// than the continent. Names on selection only were tried next and rejected,
// because a name's background halo is wider than the name, so the one country
// naming itself wiped out the numbers of the two beside it, which is the thing
// that makes the numbers work. So every country wears a number and the numbers
// key to the list, where the country and its category are spelled out. Nothing
// here is hover-only: each country's link is named "6. France: the waking hours
// only" before a pointer goes anywhere near it.
//
// Category is carried three times over, never by colour alone: fill and hatch
// are two visual channels, the number names the country in the accessible name
// of its link, and every entry in the list below states its category in words.
// The hatch says sleep is a target somewhere in the national guidance. A solid
// hatch means it is set in a document integrated with activity; a broken hatch
// means it is set in a document of its own, which is Japan. The gold fill says
// one document covers the whole day for adults, so the fill never appears
// without the hatch, and New Zealand, which covers children and not adults,
// wears the hatch alone.
//
// Provenance, the projection, the simplification, every quoted sentence and
// every translation live in src/data/world-guidelines.json, which is generated
// by scripts/build-world-map.mjs and committed.
import data from "../data/world-guidelines.json";

// The JSON is a literal, so TypeScript infers a different object type for each
// document shape it happens to find: one with `lang` and `english`, one
// without, one whose `english` has a `url` and one whose does not. Reading
// `source.lang` off that union is an error even though every branch is a
// document. These declare the shape the generator actually writes, so the
// component reads one type and the union collapses.
interface GuidelineDocument {
  publisher: string;
  title: string;
  url: string;
  quote: string;
  classifies: boolean;
  /** BCP 47 tag of `quote`, absent when the publisher writes in English. */
  lang?: string;
  english?: { text: string; kind: string; url?: string };
}

interface GuidelineCountry {
  iso: string;
  name: string;
  category: string;
  summary: string;
  documents: GuidelineDocument[];
  gap?: string;
  path: string;
  pin: { x: number; y: number; leader: { x: number; y: number } | null };
}

const { projection, categories, context } = data;
const countries = data.countries as GuidelineCountry[];

const categoryById = new Map(categories.map((category) => [category.id, category]));
const labelFor = (id: string): string => categoryById.get(id)?.label ?? id;

// Which boxes the scheme offers but nobody in this set fills. Computed rather
// than written down, so the legend cannot claim a category is empty after a
// twelfth country arrives to fill it.
const used = new Set(countries.map((country) => country.category));

// Which hatch a category wears, or none. Both hatches are the same 4.5 tile at
// stroke 1.3, sized by the smallest country that has to carry one; the broken
// one only interrupts the stroke, so it cannot become finer than the tile the
// solid one was measured for.
const hatchFor = (id: string): string | null =>
  id === "whole" || id === "children" ? "gm-hatch" : id === "split" ? "gm-hatch-split" : null;

const panelId = (iso: string): string => `guideline-${iso.toLowerCase()}`;

// The entry that is open before a reader chooses anything. Australia, because
// the lecture arrives here from a paragraph about Australia's three documents,
// and because a figure whose default state is eleven closed boxes asks the
// reader to work before it tells them anything.
const DEFAULT_ISO = "AU";

// Languages appear in the data as codes, because that is what the lang
// attribute needs. A reader needs the word.
const LANGUAGE_NAMES: Record<string, string> = {
  ja: "Japanese",
  ko: "Korean",
  "zh-Hans": "Chinese",
  de: "German",
  fr: "French",
  nl: "Dutch",
};
const languageName = (code: string): string => LANGUAGE_NAMES[code] ?? code;
---

<div class="guideline-map" data-guideline-map>
  <figure>
    <div class="plot">
      <svg viewBox={`0 0 ${projection.width} ${projection.height}`}>
        <defs>
          <!-- Two tiles, referenced from the countries and from the legend
               swatches below. currentColor resolves against this svg, so both
               follow the page into dark mode with everything else. The second
               is the first with the stroke interrupted: same tile, same
               weight, so a country wearing it is legible wherever a country
               wearing the solid one is. -->
          <pattern
            id="gm-hatch"
            width="4.5"
            height="4.5"
            patternUnits="userSpaceOnUse"
            patternTransform="rotate(45)"
          >
            <line x1="0" y1="0" x2="0" y2="8" class="hatch-line"></line>
          </pattern>
          <pattern
            id="gm-hatch-split"
            width="4.5"
            height="4.5"
            patternUnits="userSpaceOnUse"
            patternTransform="rotate(45)"
          >
            <line x1="0" y1="0" x2="0" y2="8" class="hatch-line broken"></line>
          </pattern>
        </defs>

        <path class="context" d={context}></path>

        {
          countries.map((country, index) => (
            <a
              class="country"
              href={`#${panelId(country.iso)}`}
              data-country={country.iso}
              aria-label={`${index + 1}. ${country.name}: ${labelFor(country.category).toLowerCase()}. Show its guidelines.`}
            >
              <path class:list={["shape", country.category]} d={country.path} />
              {hatchFor(country.category) && (
                <path
                  class:list={["hatch", { broken: country.category === "split" }]}
                  d={country.path}
                />
              )}
              {country.pin.leader && (
                <line
                  class="leader"
                  x1={country.pin.x}
                  y1={country.pin.y}
                  x2={country.pin.leader.x}
                  y2={country.pin.leader.y}
                />
              )}
              <circle class="pin" cx={country.pin.x} cy={country.pin.y} r="11" />
              <text class="pin-num" x={country.pin.x} y={country.pin.y} dy="0.36em">
                {index + 1}
              </text>
            </a>
          ))
        }
      </svg>
    </div>

    <ul class="key">
      {
        categories.map((category) => (
          <li class:list={["key-item", { unused: !used.has(category.id) }]}>
            <svg class="swatch" viewBox="0 0 48 30" aria-hidden="true" focusable="false">
              <rect class="context" x="0" y="0" width="48" height="30" />
              <rect class:list={["shape", category.id]} x="0" y="0" width="48" height="30" />
              {hatchFor(category.id) && (
                <rect
                  class:list={["hatch", { broken: category.id === "split" }]}
                  x="0"
                  y="0"
                  width="48"
                  height="30"
                />
              )}
              <rect class="swatch-edge" x="0.5" y="0.5" width="47" height="29" />
            </svg>
            <span class="key-text">
              <b>{category.label}</b>
              <span class="key-note">{category.description}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <figcaption>
      <p>
        Eleven countries, each marked by how much of a twenty-four hour day one
        national movement document covers. The hatch marks a country whose
        national guidance sets a sleep target, solid where that target shares a
        document with activity and broken where it has a document of its own;
        the gold fill marks a country whose adult guidance covers the whole day
        in one document, so the fill is always laid over the hatch. Each country
        carries a number, and the numbered list under the figure gives its name,
        its category in words and the sentences the category was read off.
        Select a country to open its entry. The projection is equirectangular,
        which stretches area badly away from the equator and is used anyway
        because nothing here is encoded as area. Outlines from
        <a href={data._source.url}>Natural Earth 110m</a>, public domain,
        simplified as recorded in the dataset. Sentences quoted from publishers
        that do not write in English appear in the original with an English
        rendering beside them, marked with where the English came from.
      </p>
    </figcaption>
  </figure>

  <ul class="guidelines">
    {
      countries.map((country, index) => (
        <li class="panel-item">
          <details
            class="panel"
            data-panel={country.iso}
            data-default={country.iso === DEFAULT_ISO ? "true" : undefined}
            open={country.iso === DEFAULT_ISO}
          >
            <summary id={panelId(country.iso)}>
              <span class="panel-num" aria-hidden="true">
                {index + 1}
              </span>
              <span class="panel-name">{country.name}</span>
              <span class:list={["tag", country.category]}>{labelFor(country.category)}</span>
            </summary>
            <div class="panel-body">
              <p class="says">{country.summary}</p>
              <dl class="docs">
                {country.documents.map((source) => (
                  <div class:list={["doc", { classifies: source.classifies }]}>
                    <dt>
                      <a href={source.url}>{source.title}</a>
                      <span class="pub">{source.publisher}</span>
                      {source.classifies && (
                        <span class="mark">the sentence the category rests on</span>
                      )}
                    </dt>
                    <dd>
                      {source.lang ? (
                        <span class="said-in">{languageName(source.lang)}, as published</span>
                      ) : null}
                      <q lang={source.lang ?? undefined}>{source.quote}</q>
                      {source.english && (
                        <div class="englished">
                          {source.english.kind === "publisher" ? (
                            <>
                              <span class="said-in">
                                English, from the publisher's own edition
                              </span>
                              <q>{source.english.text}</q>
                            </>
                          ) : (
                            <>
                              <span class="said-in">
                                English, translated for this course and not by the publisher
                              </span>
                              <span class="rendered">{source.english.text}</span>
                            </>
                          )}
                          {source.english.url && source.english.url !== source.url && (
                            <a class="en-source" href={source.english.url}>
                              the publisher's English edition
                            </a>
                          )}
                        </div>
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
              {country.gap && (
                <div class="gap">
                  <p class="gap-lead">No equivalent of NHMRC found</p>
                  <p class="gap-text">{country.gap}</p>
                </div>
              )}
            </div>
          </details>
        </li>
      ))
    }
  </ul>
</div>

<script>
  // Selection, and nothing else. The list works with this file deleted: eleven
  // disclosures, Australia open, each one operable on its own, and eleven
  // anchors in the map that point at their summaries. What the script adds is
  // the part the base state cannot do, which is to make the map and the list
  // agree that at most one country is showing.

  // Reassigned by every wiring pass and read by the one window listener below.
  // The listener has to live outside the pass because `window` survives a
  // ClientRouter swap while the document does not: registering it inside would
  // add a second listener on every navigation, each one still pointing at a
  // detached copy of the figure.
  let selectFromHash: (() => void) | null = null;

  function setUpGuidelineMap() {
    const root = document.querySelector<HTMLElement>("[data-guideline-map]");
    if (!root || root.dataset.wired === "true") return;
    root.dataset.wired = "true";

    const links = Array.from(root.querySelectorAll<SVGAElement>("a[data-country]"));
    const panels = Array.from(root.querySelectorAll<HTMLDetailsElement>("[data-panel]"));

    // What the figure currently says is showing. A plain reentrancy flag was
    // the first version of this and did not work: a <details> fires `toggle`
    // asynchronously, so the flag had already been cleared by the time the
    // events arrived, the entry this closed reported itself closed, and the
    // handler below dutifully reopened the default. Holding the intended
    // selection instead means a toggle that already agrees with it is the
    // script's own work and can be ignored, whenever it turns up.
    let current = "";

    const select = (iso: string): void => {
      current = iso;
      for (const panel of panels) panel.open = panel.dataset.panel === iso;
      for (const link of links) {
        const on = link.dataset.country === iso;
        link.classList.toggle("is-selected", on);
        // aria-current rather than aria-selected: these are links into a list
        // of disclosures, not tabs, and nothing here is a tablist.
        if (on) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      }
    };

    for (const link of links) {
      link.addEventListener("click", (event) => {
        const iso = link.dataset.country;
        if (!iso) return;
        const panel = panels.find((candidate) => candidate.dataset.panel === iso);
        const summary = panel?.querySelector<HTMLElement>("summary");
        if (!panel || !summary) return;
        event.preventDefault();
        select(iso);
        // The default jump is suppressed for the scroll below, which takes the
        // address bar with it, so put the fragment back. replaceState rather
        // than pushState: selecting four countries in a row should not cost a
        // reader four presses of Back to leave the page.
        window.history.replaceState(null, "", `#${summary.id}`);
        // Focus first with the scroll suppressed, then scroll deliberately, so
        // the reader who arrived by keyboard lands on the control that says
        // what is open, and the reader who arrived by mouse is not thrown to
        // the top of it.
        summary.focus({ preventScroll: true });
        const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        summary.scrollIntoView({ behavior: still ? "auto" : "smooth", block: "nearest" });
      });
    }

    // Opening an entry from the list means the same thing as selecting its
    // country on the map, so it closes the rest too. Closing the open one is
    // left alone rather than bounced back to the default: a reader who shuts
    // the entry they were reading wants it shut, and the map simply stops
    // marking anything.
    for (const panel of panels) {
      panel.addEventListener("toggle", () => {
        const iso = panel.dataset.panel ?? "";
        if (panel.open) {
          if (iso !== current) select(iso);
        } else if (iso === current) {
          select("");
        }
      });
    }

    // Arriving on a link to one of the entries should look the same as clicking
    // the country, otherwise the map contradicts the address bar. Matched
    // rather than trimmed, because every heading on the page has a fragment of
    // its own and an unrelated one must not reach select().
    const isoInHash = (): string | null => {
      const arrived = /^#guideline-([a-z]{2})$/.exec(window.location.hash);
      return arrived ? arrived[1].toUpperCase() : null;
    };

    // A fragment link from elsewhere on the same page does not reload anything,
    // and under ClientRouter it does not even fire astro:page-load, so without
    // this the address bar could name a country the figure was not showing.
    // Found by navigating to #guideline-cn from an already open page and
    // watching the previous country stay open.
    selectFromHash = () => {
      const iso = isoInHash();
      if (iso) select(iso);
    };

    const opened = panels.find((panel) => panel.open);
    select(isoInHash() ?? opened?.dataset.panel ?? "");
  }

  setUpGuidelineMap();
  // ClientRouter swaps the document on navigation, so bind again afterwards.
  document.addEventListener("astro:page-load", setUpGuidelineMap);
  window.addEventListener("hashchange", () => selectFromHash?.());
</script>

<style>
  /* The wrapper is not the figure: it holds the figure and the list of
     guidelines together so one script can find both, and so the two are never
     separated by an editor moving one of them. It carries no styling of its
     own, and specifically not `display: contents`, which was the first
     version and was wrong. The theme lays `.at-main` out as a subgrid and
     places every direct child into the `content` column; `display: contents`
     took this element out of the box tree, so the selector still matched the
     wrapper while the figure and the list became unplaced grid items and
     collapsed to 36px wide on top of each other. A plain block is the grid
     item, and everything inside it flows normally. */
  figure {
    margin-block: var(--at-spacing-lg);
    margin-inline: 0;
  }

  /* A world map does not reflow. WCAG's reflow requirement exempts exactly this
     kind of content, so the map keeps a floor width and scrolls inside its own
     box rather than shrinking until the numbers are unreadable. Scrolling
     here and not on the page: a wide element without this once pushed the whole
     phone viewport sideways and no build check noticed. */
  .plot {
    overflow-x: auto;
  }

  svg {
    width: 100%;
    height: auto;
    min-width: 32rem;
  }

  /* Every other country. Faint enough to read as ground rather than data, and
     mixed off currentColor so it follows the text into dark mode instead of
     staying a light-mode grey. Borders are drawn in the page background, so the
     land reads as one sheet with gaps cut in it. */
  .context {
    fill: color-mix(in srgb, currentColor 11%, transparent);
    stroke: var(--at-bg);
    stroke-width: 0.5;
  }

  /* The eleven. Base tint first; the category fills paint over it. */
  .shape {
    fill: color-mix(in srgb, currentColor 7%, transparent);
    stroke: currentColor;
    stroke-width: 0.9;
    stroke-linejoin: round;
  }

  /* Gold fill for the countries whose adult guidance covers the whole day in
     one document, laid over the hatch they also carry. The waking-hours
     category is deliberately the bare base tint: the category means a document
     that stops at bedtime, so the mark stops too, and the absence of a mark is
     the reading. */
  .shape.whole {
    fill: color-mix(in srgb, var(--at-primary) 48%, transparent);
  }

  /* Japan's second channel, and the one that survives the scale. At 864px the
     whole map is 38px of Japan, four thin islands, and the broken hatch inside
     them comes to two or three visible dashes: legible in the legend swatch
     and not legible on the country. The outline is the one mark a small
     country always renders at full weight, so the interruption is put there
     too. Both say the same thing, which is that the coverage arrives in
     pieces, and between them one of the two is always readable. */
  .shape.split {
    stroke-dasharray: 4 2.2;
  }

  .hatch {
    fill: url("#gm-hatch");
    stroke: none;
    opacity: 0.6;
    pointer-events: none;
  }

  .hatch.broken {
    fill: url("#gm-hatch-split");
  }

  /* Tile and stroke are set by the smallest country that has to carry the
     mark, not by the largest. At an 8 unit tile the hatch read cleanly on
     Canada at 236 units across and vanished on New Zealand at 32, whose
     landmass is two thin diagonal islands, so barely one stripe fell inside
     it. New Zealand is the country that forced the children-only category, and
     the only one wearing the hatch with no fill over it, so it is the one
     country whose mark most needs to be legible. */
  .hatch-line {
    stroke: currentColor;
    stroke-width: 1.3;
  }

  /* Japan's mark, and the reason it is a dash rather than a second angle: at
     this scale Japan is four thin islands running north-east, and a hatch laid
     along that diagonal would have fallen between the coasts instead of
     crossing them. Interrupting the stroke keeps the angle that crosses and
     still says the coverage arrives in pieces. 3.2 on, 1.3 off, against a 4.5
     tile, so exactly one gap falls inside each tile and most of the ink
     survives. */
  .hatch-line.broken {
    stroke-dasharray: 3.2 1.3;
  }

  .leader {
    stroke: currentColor;
    stroke-width: 0.8;
    opacity: 0.55;
  }

  /* The number, which is the country's name in the frame. Drawn on its own
     disc in the page background so it stays legible over the gold fill, over
     the hatch and over open water alike, and so it reads as a marker placed on
     the map rather than as a stray digit. */
  .pin {
    fill: var(--at-bg);
    stroke: currentColor;
    stroke-width: 1.1;
  }

  .pin-num {
    fill: var(--at-text);
    font-size: 16px;
    font-weight: 600;
    text-anchor: middle;
    pointer-events: none;
  }

  /* currentColor, pinned back to the body ink. Every mark in this figure is
     mixed off currentColor so it follows the theme, and these eleven are the
     one place that breaks: they are links, so the theme's `a { color: … }` rule
     repaints them, and the outlines and the hatch came out brand gold on the
     map while the legend swatches, which are not inside a link, stayed ink. The
     key and the thing it keys have to be the same colour. */
  .country {
    color: var(--at-text);
    cursor: pointer;
  }

  /* Hover, focus and selection change the outline weight and the pin's ring,
     not the fill, because the fill is the data and a state that repainted it
     would overwrite the reading. The focus ring itself is the theme's: its
     global :focus-visible rule reaches SVG children, verified by tabbing into
     the map, so a second ring defined here would only be a way for the two to
     drift apart. */
  .country:hover .shape,
  .country:focus-visible .shape,
  .country.is-selected .shape {
    stroke-width: 2.2;
  }

  .country:hover .pin,
  .country:focus-visible .pin,
  .country.is-selected .pin {
    stroke-width: 2.4;
  }

  .country.is-selected .shape,
  .country.is-selected .pin {
    stroke: var(--at-link);
  }

  /* The key. A list, because it is one: four categories, each with its mark and
     what the mark means. */
  .key {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--at-spacing-xs) var(--at-spacing-md);
    margin-block: var(--at-spacing-md) 0;
    padding: 0;
    list-style: none;
  }

  .key-item {
    display: flex;
    align-items: start;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  /* An empty box still has to appear, or a reader cannot tell a category nobody
     used from a category nobody thought of. Dimmed so it does not read as data. */
  .key-item.unused {
    opacity: 0.55;
  }

  .swatch {
    flex: none;
    width: 2.6rem;
    min-width: 0;
    height: auto;
    margin-block-start: 0.15rem;
  }

  .swatch-edge {
    fill: none;
    stroke: var(--at-border);
    stroke-width: 1;
  }

  .key-text {
    display: block;
  }

  .key-text b {
    display: block;
    font-weight: 600;
  }

  .key-note {
    color: var(--at-text-secondary);
  }

  figcaption {
    margin-block-start: var(--at-spacing-md);
    color: var(--at-text-secondary);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  figcaption p {
    margin-block: 0;
  }

  /* The guidelines themselves. This is the content, and it is a plain list of
     disclosures that would still be a plain list of disclosures with the
     figure deleted and with scripting off. */
  .guidelines {
    margin-block: var(--at-spacing-lg);
    padding: 0;
    list-style: none;
  }

  .panel-item {
    margin-block: 0 var(--at-spacing-xs);
  }

  .panel {
    border-inline-start: 3px solid var(--at-border);
  }

  .panel[open] {
    border-inline-start-color: var(--at-link);
  }

  .panel summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    padding: var(--at-spacing-xs) var(--at-spacing-md);
    cursor: pointer;
  }

  /* The number that keys the map, and it is decorative here: the entry already
     says the country and the category in words, so a screen reader announcing
     "6" before "France" would be reading the map's key aloud to somebody who
     has no map. */
  .panel-num {
    flex: none;
    min-width: 1.5em;
    color: var(--at-text-secondary);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .panel-name {
    font-weight: 600;
  }

  .panel-body {
    padding: 0 var(--at-spacing-md) var(--at-spacing-sm);
  }

  /* The category in words, next to the country's name, so the classification is
     legible to a reader who never sees the map at all. */
  .tag {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--at-border);
    border-radius: 999px;
    color: var(--at-text-secondary);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.04em;
