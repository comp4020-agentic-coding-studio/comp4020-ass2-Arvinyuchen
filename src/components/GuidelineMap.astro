---
// Five countries, coloured by how their sun guidance states when it applies.
//
// The section this sits in argues that place is settled for you before you read
// a word, and that the same question gets answered differently country by
// country. The figure is that comparison: a season, a condition, both, or
// neither, one category per country, put on the map so the border carries the
// fact. A click-to-reveal map with grey countries would have been a menu in a
// figure's clothes, because then the geography would encode nothing at all and
// a plain list would do the same job better.
//
// Built list first, map second, and that order is load-bearing. The guidelines
// are a <ul> of five entries with their quoted sentences, always visible, in
// the document whether or not anything renders. The map is five links into that
// list. Nothing a reader needs is reachable only by clicking a country, which
// is also why the interaction can be as small as it is: the script marks the
// selection and moves focus, and the anchors would still work without it.
//
// Category is carried three times over, never by colour alone: fill and hatch
// are two visual channels (the "both" swatch is literally the season fill with
// the condition hatch laid over it), each country wears its own name in the
// frame, and every entry in the list below states its category in words.
//
// Provenance, the projection, the simplification and every quoted sentence live
// in src/data/world-guidelines.json, which is generated by
// scripts/build-world-map.mjs and committed.
import data from "../data/world-guidelines.json";

const { projection, categories, countries, context } = data;

const categoryById = new Map(categories.map((category) => [category.id, category]));
const labelFor = (id: string): string => categoryById.get(id)?.label ?? id;

// Which boxes the scheme offers but nobody in this set fills. Computed rather
// than written down, so the legend cannot claim a category is empty after a
// sixth country arrives to fill it.
const used = new Set(countries.map((country) => country.category));

// The two categories whose mark includes the hatch. "both" gets the season fill
// as well, so the compound category looks like the compound of its parts.
const hatched = (id: string): boolean => id === "condition" || id === "both";

const panelId = (iso: string): string => `guideline-${iso.toLowerCase()}`;
---

<div class="guideline-map" data-guideline-map>
  <figure>
    <div class="plot">
      <svg viewBox={`0 0 ${projection.width} ${projection.height}`}>
        <defs>
          <!-- One tile, referenced from the countries and from the legend
               swatches below. currentColor resolves against this svg, so the
               hatch follows the page into dark mode with everything else. -->
          <pattern
            id="gm-hatch"
            width="4.5"
            height="4.5"
            patternUnits="userSpaceOnUse"
            patternTransform="rotate(45)"
          >
            <line x1="0" y1="0" x2="0" y2="8" class="hatch-line"></line>
          </pattern>
        </defs>

        <path class="context" d={context}></path>

        {
          countries.map((country) => (
            <a
              class="country"
              href={`#${panelId(country.iso)}`}
              data-country={country.iso}
              aria-label={`${country.name}: ${labelFor(country.category).toLowerCase()}. Jump to its guidelines.`}
            >
              <path class:list={["shape", country.category]} d={country.path} />
              {hatched(country.category) && <path class="hatch" d={country.path} />}
              {country.label.leader && (
                <line
                  class="leader"
                  x1={country.label.leader.x1}
                  y1={country.label.leader.y1}
                  x2={country.label.leader.x2}
                  y2={country.label.leader.y2}
                />
              )}
              <text
                class="name"
                x={country.label.x}
                y={country.label.y}
                text-anchor={country.label.anchor}
              >
                {
                  country.label.lines
                    ? country.label.lines.map((line, index) => (
                        <tspan x={country.label.x} dy={index === 0 ? 0 : 20}>
                          {line}
                        </tspan>
                      ))
                    : country.name
                }
              </text>
            </a>
          ))
        }
      </svg>
    </div>

    <ul class="key">
      {
        categories.map((category) => (
          <li class:list={["key-item", { unused: !used.has(category.id) }]}>
            <svg class="swatch" viewBox="0 0 48 30" aria-hidden="true" focusable="false">
              <rect class="context" x="0" y="0" width="48" height="30" />
              <rect class:list={["shape", category.id]} x="0" y="0" width="48" height="30" />
              {hatched(category.id) && (
                <rect class="hatch" x="0" y="0" width="48" height="30" />
              )}
              <rect class="swatch-edge" x="0.5" y="0.5" width="47" height="29" />
            </svg>
            <span class="key-text">
              <b>{category.label}</b>
              <span class="key-note">{category.description}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <figcaption>
      <p>
        Five countries, each filled by how its national guidance states when the
        advice applies. Fill and hatch carry the category together, every country
        is named in the frame, and the guidelines themselves are listed under the
        figure; select a country to jump to its entry. The projection is
        equirectangular, which stretches area badly away from the equator and is
        used anyway because nothing here is encoded as area. Outlines from <a
          href={data._source.url}>Natural Earth 110m</a
        >, public domain, simplified as recorded in the dataset. Each category
        rests on one quoted sentence, credited under the country it classifies.
      </p>
    </figcaption>
  </figure>

  <ul class="guidelines">
    {
      countries.map((country) => (
        <li class="panel" id={panelId(country.iso)} data-panel={country.iso} tabindex="-1">
          <h4>
            <span class="panel-name">{country.name}</span>
            <span class:list={["tag", country.category]}>{labelFor(country.category)}</span>
          </h4>
          <p class="says">{country.summary}</p>
          <dl class="docs">
            {country.documents.map((source) => (
              <div class:list={["doc", { classifies: source.classifies }]}>
                <dt>
                  <a href={source.url}>{source.title}</a>
                  <span class="pub">{source.publisher}</span>
                  {source.classifies && (
                    <span class="mark">the sentence the category rests on</span>
                  )}
                </dt>
                <dd>
                  <q>{source.quote}</q>
                </dd>
              </div>
            ))}
          </dl>
          {country.starting_points && (
            <div class="starts">
              <p class="starts-lead">
                Not about the sun, and carried here because this course is taught
                in Australia: the three national documents to start from.
              </p>
              <ul>
                {country.starting_points.map((start) => (
                  <li>
                    <a href={start.url}>{start.title}</a>
                    <span class="start-note">{start.note}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))
    }
  </ul>
</div>

<script>
  // Selection and focus. The anchors already work without any of this: each one
  // points at its entry's id, so the figure degrades to five in-page links.
  // What the script adds is the part a fragment jump cannot do, marking which
  // country is selected in both places at once.
  function setUpGuidelineMap() {
    const root = document.querySelector<HTMLElement>("[data-guideline-map]");
    if (!root || root.dataset.wired === "true") return;
    root.dataset.wired = "true";

    const links = Array.from(root.querySelectorAll<SVGAElement>("a[data-country]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-panel]"));

    const select = (iso: string): void => {
      for (const link of links) {
        const on = link.dataset.country === iso;
        link.classList.toggle("is-selected", on);
        // aria-current rather than aria-selected: these are links into a list,
        // not tabs, and nothing here is a tablist.
        if (on) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      }
      for (const panel of panels) panel.classList.toggle("is-selected", panel.dataset.panel === iso);
    };

    for (const link of links) {
      link.addEventListener("click", (event) => {
        const iso = link.dataset.country;
        if (!iso) return;
        const panel = panels.find((candidate) => candidate.dataset.panel === iso);
        if (!panel) return;
        event.preventDefault();
        select(iso);
        // The default jump is suppressed for the scroll below, which takes the
        // address bar with it, so put the fragment back. replaceState rather
        // than pushState: selecting four countries in a row should not cost a
        // reader four presses of Back to leave the page.
        window.history.replaceState(null, "", `#${panel.id}`);
        // Focus first with the scroll suppressed, then scroll deliberately, so
        // the reader who arrived by keyboard lands in the entry and the reader
        // who arrived by mouse is not thrown to the top of it.
        panel.focus({ preventScroll: true });
        const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        panel.scrollIntoView({ behavior: still ? "auto" : "smooth", block: "nearest" });
      });
    }

    // Arriving on a link to one of the entries should look the same as clicking
    // the country, otherwise the map contradicts the address bar. Matched
    // rather than trimmed, because every heading on the page has a fragment of
    // its own and an unrelated one must not reach select().
    const arrived = /^#guideline-([a-z]{2})$/.exec(window.location.hash);
    if (arrived) select(arrived[1].toUpperCase());
  }

  setUpGuidelineMap();
  // ClientRouter swaps the document on navigation, so bind again afterwards.
  document.addEventListener("astro:page-load", setUpGuidelineMap);
</script>

<style>
  /* The wrapper is not the figure: it holds the figure and the list of
     guidelines together so one script can find both, and so the two are never
     separated by an editor moving one of them. It carries no styling of its
     own, and specifically not `display: contents`, which was the first
     version and was wrong. The theme lays `.at-main` out as a subgrid and
     places every direct child into the `content` column; `display: contents`
     took this element out of the box tree, so the selector still matched the
     wrapper while the figure and the list became unplaced grid items and
     collapsed to 36px wide on top of each other. A plain block is the grid
     item, and everything inside it flows normally. */
  figure {
    margin-block: var(--at-spacing-lg);
    margin-inline: 0;
  }

  /* A world map does not reflow. WCAG's reflow requirement exempts exactly this
     kind of content, so the map keeps a floor width and scrolls inside its own
     box rather than shrinking until the country names are unreadable. Scrolling
     here and not on the page: a wide element without this once pushed the whole
     phone viewport sideways and no build check noticed. */
  .plot {
    overflow-x: auto;
  }

  svg {
    width: 100%;
    height: auto;
    min-width: 32rem;
  }

  /* Every other country. Faint enough to read as ground rather than data, and
     mixed off currentColor so it follows the text into dark mode instead of
     staying a light-mode grey. Borders are drawn in the page background, so the
     land reads as one sheet with gaps cut in it. */
  .context {
    fill: color-mix(in srgb, currentColor 11%, transparent);
    stroke: var(--at-bg);
    stroke-width: 0.5;
  }

  /* The five. Base tint first; the category fills paint over it. */
  .shape {
    fill: color-mix(in srgb, currentColor 7%, transparent);
    stroke: currentColor;
    stroke-width: 0.9;
    stroke-linejoin: round;
  }

  /* Season is the brand gold, condition is the hatch, and "both" is the two
     marks stacked, which is the whole reason the compound category is drawable
     at all. "Neither" is deliberately the bare base tint: the category means
     the document said nothing, so the mark says nothing either. */
  .shape.season,
  .shape.both {
    fill: color-mix(in srgb, var(--at-primary) 48%, transparent);
  }

  .hatch {
    fill: url("#gm-hatch");
    stroke: none;
    opacity: 0.6;
    pointer-events: none;
  }

  /* Tile and stroke are set by the smallest country that has to carry the
     mark, not by the largest. At an 8 unit tile the hatch read cleanly on
     Canada at 236 units across and vanished on New Zealand at 32, whose
     landmass is two thin diagonal islands, so barely one stripe fell inside
     it. New Zealand is the country that broke the three-category scheme, so
     it is the one country whose mark most needs to be legible. */
  .hatch-line {
    stroke: currentColor;
    stroke-width: 1.3;
  }

  .leader {
    stroke: currentColor;
    stroke-width: 0.8;
    opacity: 0.55;
  }

  /* Country names sit over their own fill, over the hatch, and in the United
     Kingdom's case over open water next to a leader. paint-order puts a
     background-coloured stroke behind the glyphs so the text stays readable on
     all three without a box around it. */
  .name {
    fill: var(--at-text);
    font-size: 19px;
    paint-order: stroke fill;
    stroke: var(--at-bg);
    stroke-width: 4px;
    stroke-linejoin: round;
    pointer-events: none;
  }

  /* currentColor, pinned back to the body ink. Every mark in this figure is
     mixed off currentColor so it follows the theme, and these five are the one
     place that breaks: they are links, so the theme's `a { color: … }` rule
     repaints them, and the outlines and the hatch came out brand gold on the
     map while the legend swatches, which are not inside a link, stayed ink. The
     key and the thing it keys have to be the same colour. */
  .country {
    color: var(--at-text);
    cursor: pointer;
  }

  /* Hover, focus and selection change the outline weight, not the fill, because
     the fill is the data and a state that repainted it would overwrite the
     reading. The focus ring itself is the theme's: its global :focus-visible
     rule reaches SVG children, verified by tabbing into the map, so a second
     ring defined here would only be a way for the two to drift apart. */
  .country:hover .shape,
  .country:focus-visible .shape,
  .country.is-selected .shape {
    stroke-width: 2.2;
  }

  .country.is-selected .shape {
    stroke: var(--at-link);
  }

  /* The key. A list, because it is one: four categories, each with its mark and
     what the mark means. */
  .key {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--at-spacing-xs) var(--at-spacing-md);
    margin-block: var(--at-spacing-md) 0;
    padding: 0;
    list-style: none;
  }

  .key-item {
    display: flex;
    align-items: start;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  /* An empty box still has to appear, or a reader cannot tell a category nobody
     used from a category nobody thought of. Dimmed so it does not read as data. */
  .key-item.unused {
    opacity: 0.55;
  }

  .swatch {
    flex: none;
    width: 2.6rem;
    min-width: 0;
    height: auto;
    margin-block-start: 0.15rem;
  }

  .swatch-edge {
    fill: none;
    stroke: var(--at-border);
    stroke-width: 1;
  }

  .key-text {
    display: block;
  }

  .key-text b {
    display: block;
    font-weight: 600;
  }

  .key-note {
    color: var(--at-text-secondary);
  }

  figcaption {
    margin-block-start: var(--at-spacing-md);
    color: var(--at-text-secondary);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  figcaption p {
    margin-block: 0;
  }

  /* The guidelines themselves. This is the content, and it is a plain list that
     would still be a plain list with the figure deleted. */
  .guidelines {
    margin-block: var(--at-spacing-lg);
    padding: 0;
    list-style: none;
  }

  .panel {
    margin-block: 0 var(--at-spacing-md);
    padding: var(--at-spacing-sm) var(--at-spacing-md);
    border-inline-start: 3px solid var(--at-border);
  }

  .panel.is-selected {
    border-inline-start-color: var(--at-link);
  }

  .panel h4 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-block: 0 var(--at-spacing-xs);
  }

  /* The category in words, next to the country's name, so the classification is
     legible to a reader who never sees the map at all. */
  .tag {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--at-border);
    border-radius: 999px;
    color: var(--at-text-secondary);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .tag.season,
  .tag.both {
    border-color: var(--at-primary);
    color: var(--at-primary);
  }

  .says {
    margin-block: 0 var(--at-spacing-sm);
  }

  .docs {
    margin-block: 0;
  }

  .doc {
    margin-block-end: var(--at-spacing-sm);
    font-size: 0.85rem;
  }

  .doc:last-child {
    margin-block-end: 0;
  }

  .doc dt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-weight: 600;
  }

  .doc dd {
    margin-inline-start: 0;
    margin-block-start: 0.15rem;
    color: var(--at-text-secondary);
  }

  .pub {
    color: var(--at-text-secondary);
    font-weight: 400;
  }

  /* Which of a country's documents the category was read off. Australia cites
     three that agree, so without this a reader cannot tell which sentence is
     doing the classifying and which are corroboration. */
  .mark {
    color: var(--at-primary);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .doc.classifies dd {
    color: var(--at-text);
  }

  .starts {
    margin-block-start: var(--at-spacing-md);
    padding-block-start: var(--at-spacing-sm);
    border-block-start: 1px solid var(--at-border);
    font-size: 0.85rem;
  }

  .starts-lead {
    margin-block: 0 var(--at-spacing-xs);
    color: var(--at-text-secondary);
  }

  .starts ul {
    margin-block: 0;
  }

  .start-note {
    display: block;
    color: var(--at-text-secondary);
  }
</style>
