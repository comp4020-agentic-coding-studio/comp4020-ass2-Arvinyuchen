---
// A week's method, what it takes apart, what it builds on, and — for anything
// above the lowest risk — the safety block.
//
// The duty-of-care fields are checked by the schema and by spec/, but a check
// only guarantees they exist in the data. This component is what gets them in
// front of the student who needs them, which is the point of collecting them.
import { getPublishedCollection } from "astro-course-university/content";
import type { CollectionEntry } from "astro:content";
import Callout from "astro-theme-university/components/Callout.astro";
import { withBase } from "astro-theme-university/url";

interface Props {
  week: CollectionEntry<"sessions">;
}

const { week } = Astro.props;
const { method, component, needs, risk, stopping_rule, harm_boundary, opt_out } = week.data;

// `needs` holds week numbers, so resolve them to real pages to link.
const all = await getPublishedCollection("sessions");
const byWeek = new Map(all.map((entry) => [entry.data.week, entry]));
const prerequisites = (needs ?? [])
  .map((number) => byWeek.get(number))
  .filter((entry): entry is CollectionEntry<"sessions"> => entry !== undefined)
  .sort((a, b) => a.data.week - b.data.week);

const takesCare = risk === "med" || risk === "high";
---

<section aria-labelledby="protocol">
  <h2 id="protocol">The protocol</h2>

  <dl class="protocol-fields">
    {method && (
      <>
        <dt>Method</dt>
        <dd>{method}</dd>
      </>
    )}
    {component && (
      <>
        <dt>What it takes apart</dt>
        <dd>{component}</dd>
      </>
    )}
    <dt>Risk</dt>
    <dd>{risk ?? "not yet assessed"}</dd>
    {prerequisites.length > 0 && (
      <>
        <dt>Builds on</dt>
        <dd>
          {prerequisites.map((entry, index) => (
            <>
              {index > 0 && ", "}
              <a href={withBase(`/sessions/${entry.id}/`)}>
                week {entry.data.week}
              </a>
            </>
          ))}
        </dd>
      </>
    )}
  </dl>

  {
    takesCare && (
      <Callout type="warning">
        <h3>Before you run this</h3>
        {stopping_rule && (
          <p><strong>When to stop.</strong> {stopping_rule}</p>
        )}
        {harm_boundary && (
          <p><strong>What this is not.</strong> {harm_boundary}</p>
        )}
        {opt_out && (
          <p><strong>If this one isn't for you.</strong> {opt_out}</p>
        )}
      </Callout>
    )
  }
</section>

<style>
  /* An unstyled dl stacks label and value as two loose lines, which reads as
     prose rather than as a specification. A label column makes it scannable —
     and collapses back to stacked rows on a phone, where there is no room. */
  .protocol-fields {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.35rem 1rem;
    margin-block-end: var(--at-spacing-md, 1rem);
  }

  .protocol-fields dt {
    font-weight: 600;
    color: var(--at-text-secondary);
  }

  .protocol-fields dd {
    margin: 0;
  }

  @media (max-width: 28rem) {
    .protocol-fields {
      grid-template-columns: 1fr;
      gap: 0 0;
    }

    .protocol-fields dd {
      margin-block-end: 0.5rem;
    }
  }
</style>
