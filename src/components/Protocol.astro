---
// A week's method, what it takes apart, and what it builds on.
//
// This has moved twice. It started as an h2 headed "The protocol" above a
// definition list, which put ten lines of metadata between the reader and the
// first line of the lesson. It became a strip of label/value pairs under the
// date, which was three lines instead of ten but was still a block of
// reference material sitting in the reading position.
//
// It is apparatus, so it now lives with the apparatus at the foot of the page,
// alongside the evidence, the spec, the teaching team and the related links. A
// lab page is three layers: the title and what a reader needs to decide
// whether to start, the lesson, and everything the lesson refers to. Method
// and component are the third kind. Risk is not, and it left with the move: it
// is on the title line now, beside the date, because a student deciding
// whether they can run this week must not have to reach the foot of the page
// to find out.
//
// `needs` keeps its own row. It is the only field here whose length is
// unbounded: week 1 has none and week 12 builds on all eleven earlier weeks,
// which ran to two lines of links and dragged everything after it out of
// position. Giving it the whole row means the two fixed fields are always the
// first line, on all twelve weeks.
import { getPublishedCollection } from "astro-course-university/content";
import type { CollectionEntry } from "astro:content";
import { withBase } from "astro-theme-university/url";

interface Props {
  week: CollectionEntry<"sessions">;
}

const { week } = Astro.props;
const { method, component, needs } = week.data;

// `needs` holds week numbers, so resolve them to real pages to link.
const all = await getPublishedCollection("sessions");
const byWeek = new Map(all.map((entry) => [entry.data.week, entry]));
const prerequisites = (needs ?? [])
  .map((number) => byWeek.get(number))
  .filter((entry): entry is CollectionEntry<"sessions"> => entry !== undefined)
  .sort((a, b) => a.data.week - b.data.week);

const anything = Boolean(method || component || prerequisites.length > 0);
---

{
  anything && (
    <section class="protocol-section" aria-labelledby="the-protocol">
      <h2 id="the-protocol">The protocol</h2>
      <dl class="protocol">
        {method && (
          <div>
            <dt>Method</dt>
            <dd>{method}</dd>
          </div>
        )}
        {component && (
          <div>
            <dt>Takes apart</dt>
            <dd>{component}</dd>
          </div>
        )}
        {prerequisites.length > 0 && (
          <div class="builds-on">
            <dt>Builds on</dt>
            <dd>
              {prerequisites.map((entry, index) => (
                <>
                  {index > 0 && ", "}
                  <a href={withBase(`/sessions/${entry.id}/`)}>week {entry.data.week}</a>
                </>
              ))}
            </dd>
          </div>
        )}
      </dl>
    </section>
  )
}

<style>
  /* A spec sheet: label above value, wrapping across the column. Two short
     facts on one line rather than two rows of a table, because a two-row table
     of two cells is table machinery around nothing. */
  .protocol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--at-spacing-md) var(--at-spacing-xl);
    margin-block: 0 1em;
  }

  .protocol > div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  /* The whole row, and last, whatever the source order. `order` alone would
     move it; the full basis is what stops the two fixed cells wrapping up
     beside it on a wide screen and reintroducing the drift. */
  .protocol .builds-on {
    order: 1;
    flex-basis: 100%;
  }

  /* The same small uppercase label the rest of the page's label/value pairs
     use, so a reader meets one idiom and not three. */
  .protocol dt {
    color: var(--at-text-secondary);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .protocol dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
</style>
