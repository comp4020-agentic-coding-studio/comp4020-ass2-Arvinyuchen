---
// A week's method, what it takes apart, what it builds on, and for anything
// above the lowest risk, the safety block.
//
// This used to be an h2 headed "The protocol" above a definition list, which
// put a block of metadata between the reader and the first line of the lesson.
// It is now a strip of label/value pairs directly under the date: it reads as
// a spec sheet, takes three lines instead of ten, and gets out of the way.
//
// The safety block keeps full prominence. The duty-of-care fields are checked
// by the schema and by spec/, but a check only proves they exist in the data.
// This is what puts them in front of the student who needs them.
import { getPublishedCollection } from "astro-course-university/content";
import type { CollectionEntry } from "astro:content";
import Callout from "astro-theme-university/components/Callout.astro";
import Icon from "astro-theme-university/components/Icon.astro";
import { withBase } from "astro-theme-university/url";

interface Props {
  week: CollectionEntry<"sessions">;
}

const { week } = Astro.props;
const { method, component, needs, risk, stopping_rule, harm_boundary, opt_out } = week.data;

// `needs` holds week numbers, so resolve them to real pages to link.
const all = await getPublishedCollection("sessions");
const byWeek = new Map(all.map((entry) => [entry.data.week, entry]));
const prerequisites = (needs ?? [])
  .map((number) => byWeek.get(number))
  .filter((entry): entry is CollectionEntry<"sessions"> => entry !== undefined)
  .sort((a, b) => a.data.week - b.data.week);

const takesCare = risk === "med" || risk === "high";
---

<dl class="protocol" aria-label="Protocol">
  {
    method && (
      <div>
        <dt>Method</dt>
        <dd>{method}</dd>
      </div>
    )
  }
  {
    component && (
      <div>
        <dt>Takes apart</dt>
        <dd>{component}</dd>
      </div>
    )
  }
  {
    prerequisites.length > 0 && (
      <div>
        <dt>Builds on</dt>
        <dd>
          {prerequisites.map((entry, index) => (
            <>
              {index > 0 && ", "}
              <a href={withBase(`/sessions/${entry.id}/`)}>week {entry.data.week}</a>
            </>
          ))}
        </dd>
      </div>
    )
  }
  {
    risk && (
      <div>
        <dt>Risk</dt>
        <dd class={`risk risk-${risk}`}>{risk === "med" ? "medium" : risk}</dd>
      </div>
    )
  }
</dl>

{
  takesCare && (
    <Callout type="warning">
      <h2 class="safety-heading">
        <Icon name="warning-triangle" /> Before you run this
      </h2>
      {stopping_rule && (
        <p>
          <strong>When to stop.</strong> {stopping_rule}
        </p>
      )}
      {harm_boundary && (
        <p>
          <strong>What this is not.</strong> {harm_boundary}
        </p>
      )}
      {opt_out && (
        <p>
          <strong>If this one isn't for you.</strong> {opt_out}
        </p>
      )}
    </Callout>
  )
}

<style>
  /* A spec sheet, not a section: label above value, wrapping across the
     column, so four facts take three lines rather than ten. */
  .protocol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-block: 0 var(--at-spacing-lg);
    padding-block-end: var(--at-spacing-md);
    border-block-end: 1px solid var(--at-bg-alt);
  }

  .protocol div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .protocol dt {
    color: var(--at-text-secondary);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .protocol dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  /* Risk is the one value a reader scans for, so it is the one that is
     allowed to look different. Weight rather than colour, because colour
     alone would not survive a greyscale print or a colour-blind reader. */
  .risk {
    font-weight: 600;
  }

  .risk-high::before,
  .risk-med::before {
    content: "▲ ";
    color: var(--at-primary);
  }

  /* The callout supplies the box; this is the icon and the label inside it.
     Sized down from a normal h2, it is a warning, not a chapter. */
  .safety-heading {
    display: flex;
    align-items: center;
    gap: 0.45em;
    margin-block: 0 var(--at-spacing-sm);
    font-size: var(--at-font-size-h3);
    line-height: 1.25;
  }
</style>
