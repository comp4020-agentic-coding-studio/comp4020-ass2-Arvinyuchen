---
import { getEntries, type CollectionEntry } from "astro:content";
import { withBase } from "astro-theme-university/url";
import { roleLabel } from "../lib/roles";

interface Props {
  teachers: CollectionEntry<"sessions">["data"]["teachers"] | CollectionEntry<"lectures">["data"]["teachers"];
}

const { teachers } = Astro.props;
// A session or lecture with no `teachers:` renders no team at all.
const people = teachers ? await getEntries(teachers) : [];
---

{
  people.length > 0 && (
    <section class="teaching-team" aria-labelledby="teaching-team">
      <h2 id="teaching-team">Teaching team</h2>
      <ul>
        {people.map((person) => (
          <li>
            <a href={withBase(`/people/${person.id}/`)}>{person.data.title}</a><span class="role">, {roleLabel(person.data.role)}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  /* The role was bracketed at body size, so "(tutor)" carried the same weight
     as the person's name and the brackets were doing the work of saying which
     of the two was which. Quiet and smaller says it better, and the line still
     reads as a sentence when a screen reader flattens the styling away, which
     is why the comma stayed and the brackets did not. */
  .role {
    color: var(--at-text-secondary);
    font-size: 0.9rem;
  }
</style>
