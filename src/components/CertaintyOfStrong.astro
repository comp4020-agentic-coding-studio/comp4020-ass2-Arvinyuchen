---
// What the evidence behind a strong recommendation actually looks like.
//
// The block this sits in argues that a guideline rates itself twice, and that
// the two ratings come apart. That has a shape: ordered by certainty, the
// counts are 24, 31, 18, 60, 18, so the largest single group of strong
// recommendations rests on the weakest evidence there is. Prose can say that in
// sequence but cannot show the lump at the bottom, which is what earns the
// figure.
//
// A real table rather than a picture of one, for the same reason as the UV
// figure: the numbers are the content, and a course about reading numbers puts
// them where a reader can check them. The bars are a second channel over the
// top.
//
// The concordant and discordant groups are separated by labelled row groups,
// not by colour. Colour is doing no work here that the text does not already
// do, which is deliberate: the figure has to survive being printed, and axe
// runs the full rule set over this page at build time.
import data from "../data/grade-discordance.json";

const rows = data.certainty_of_strong_recommendations;
const peak = Math.max(...rows.map((row) => row.count));

const concordant = rows.filter((row) => !row.discordant);
const discordant = rows.filter((row) => row.discordant);
const concordantTotal = concordant.reduce((sum, row) => sum + row.count, 0);
---

<figure class="certainty">
  <table>
    <caption class="visually-hidden">
      The {data.strong} strong recommendations, broken down by the certainty of
      the evidence supporting each one.
    </caption>
    <thead>
      <tr>
        <th scope="col">Certainty</th>
        <th scope="col">Strong recommendations</th>
        <th scope="col" class="num">Share</th>
      </tr>
    </thead>
    <tbody>
      <tr class="group">
        <th scope="colgroup" colspan="3">
          Backed by high or moderate certainty: {concordantTotal} of {data.strong}
        </th>
      </tr>
      {
        concordant.map((row) => (
          <tr>
            <th scope="row">{row.certainty}</th>
            <td class="bar-cell">
              <span class="bar" style={`--w: ${(row.count / peak) * 100}%`} />
              <span class="count">{row.count}</span>
            </td>
            <td class="num">{row.percent}%</td>
          </tr>
        ))
      }
      <tr class="group">
        <th scope="colgroup" colspan="3">
          Discordant, strong on low certainty or none: {data.discordant} of {data.strong}
        </th>
      </tr>
      {
        discordant.map((row) => (
          <tr class="is-discordant">
            <th scope="row">{row.certainty}</th>
            <td class="bar-cell">
              <span class="bar" style={`--w: ${(row.count / peak) * 100}%`} />
              <span class="count">{row.count}</span>
            </td>
            <td class="num">{row.percent}%</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <figcaption>
    <p>
      Each bar is the number of strong recommendations resting on that level of
      certainty, out of {data.strong} strong recommendations in {
        data.guidelines_analysed
      } guidelines. Rows are grouped by whether the strength rating and the
      certainty rating agree. From <a href={data._source.url}
        >{data._source.dataset}</a
      >. {data._source.publisher}. Used under <a href={data._source.licence_url}
        >{data._source.licence}</a
      >.
    </p>
  </figcaption>
</figure>

<style>
  .certainty {
    margin-block: var(--at-spacing-lg);
    margin-inline: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  /* The table caption states what the table is for a screen reader, which the
     figcaption cannot do because it is outside the table. Hidden rather than
     removed: axe wants tables named, and sighted readers already have the
     heading above and the caption below. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The theme paints table headers with the brand colour and stripes the body
     rows. Both were fought once already on the UV table: the gold bar outweighs
     the data it labels and puts secondary grey on a saturated ground, and the
     stripes add a background under the one carrying the values. Note this
     resets `thead` itself, not only `thead th`. Resetting the cells leaves the
     paint on the ancestor and it shows straight through them, which cost a
     round of "fixed" that was still visibly gold on screen. */
  .certainty thead,
  .certainty thead th,
  .certainty tbody tr,
  .certainty tbody th {
    background: transparent;
  }

  th,
  td {
    padding: 0.35rem 0.5rem;
    text-align: start;
    font-weight: 400;
    vertical-align: middle;
  }

  thead th {
    color: var(--at-text-secondary);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-block-end: 1px solid var(--at-border);
  }

  /* The group rows are the non-colour channel. Whether a row is discordant is
     stated in words once per group rather than encoded in the bar's fill. */
  .group th {
    padding-block-start: var(--at-spacing-md);
    color: var(--at-text-secondary);
    font-size: 0.8rem;
  }

  tbody th[scope="row"] {
    width: 1%;
    white-space: nowrap;
    font-size: 0.9rem;
  }

  .bar-cell {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bar {
    display: block;
    width: var(--w);
    height: 0.7rem;
    border-radius: 2px;
    background: currentColor;
    opacity: 0.22;
    flex: 0 0 auto;
  }

  /* The lump at the bottom is the finding, so the row that carries it is the
     one drawn at full strength. Colour is reinforcing the group label here,
     never replacing it. */
  .is-discordant .bar {
    background: var(--at-primary);
    opacity: 0.85;
  }

  .count {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .num {
    text-align: end;
    white-space: nowrap;
    font-size: 0.85rem;
    color: var(--at-text-secondary);
  }

  figcaption {
    margin-block-start: var(--at-spacing-md);
    color: var(--at-text-secondary);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  figcaption p {
    margin-block: 0;
  }

  @media (width < 34rem) {
    .bar-cell {
      flex-wrap: wrap;
    }
  }
</style>
