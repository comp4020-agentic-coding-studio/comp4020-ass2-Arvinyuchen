---
// What the evidence behind a strong recommendation actually looks like, one
// square per recommendation.
//
// This was a bar chart first, and the bars were wrong for the job. The question
// the block asks is "how much of this is well supported", which is a part to
// whole question, and five bars make a reader sum four of them to answer it.
// One square per recommendation answers it by area, and keeps 151 feeling like
// 151 real recommendations in real guidelines rather than a percentage.
//
// A pie was the other candidate and loses on the same numbers: four of the five
// categories are 18, 18, 24 and 31, and nobody can judge angles that close, so
// the slices a reader might want to compare are the ones a pie hides.
//
// Three visual states, not five, and that number came from the validator rather
// than from taste. Certainty is ordered, so the ramp is one hue stepped by
// lightness, which means ink density reads as evidential support. Stepped five
// ways on this surface the pale end collapses: #f4ebdd against #ebdbc0 is
// deltaE 5.0 to normal vision against a floor of 15, so "sub-shaded by which"
// is not a thing a reader could have seen. Three steps spread across the full
// range clear it at 16.
//
// So the five published categories map onto three states that are themselves
// meaningful rather than convenient: the evidence backs it, the evidence is
// weak, or there is no evidence. The exact five way counts stay in the table,
// which is also what discharges the validator's contrast warning: every state
// carries a visible label and an exact number, so nothing rests on the fill
// alone.
//
// No per square hover. The skill's default is a tooltip on every cell, and it
// is wrong here: the squares are interchangeable units with no identity of
// their own, so a tooltip would say "very low certainty" sixty times.
import data from "../data/grade-discordance.json";

const rows = data.certainty_of_strong_recommendations;

// Ordered worst last, so the grid reads from support to its absence.
type State = "backed" | "weak" | "none";
const stateOf = (certainty: string): State =>
  certainty === "High" || certainty === "Moderate"
    ? "backed"
    : certainty === "No studies"
      ? "none"
      : "weak";

const STATES: { id: State; label: string; note: string }[] = [
  { id: "backed", label: "The evidence backs it", note: "high or moderate certainty" },
  { id: "weak", label: "The evidence is weak", note: "low or very low certainty" },
  { id: "none", label: "There is no evidence", note: "no studies included" },
];

const countFor = (state: State): number =>
  rows.filter((row) => stateOf(row.certainty) === state).reduce((sum, row) => sum + row.count, 0);

const grouped = STATES.map((state) => ({
  ...state,
  count: countFor(state.id),
  rows: rows.filter((row) => stateOf(row.certainty) === state.id),
}));

// One entry per recommendation, in state order.
const squares = grouped.flatMap((group) => Array.from({ length: group.count }, () => group.id));

const share = (n: number): string => `${((n / data.strong) * 100).toFixed(1)}%`;
---

<figure class="certainty">
  <!-- The grid is the picture of the table below it, so it is hidden from
       assistive tech rather than announced as 151 anonymous list items. The
       table carries every number. -->
  <div class="grid" aria-hidden="true">
    {squares.map((state) => <span class:list={["unit", state]} />)}
  </div>

  <table>
    <caption class="visually-hidden">
      The {data.strong} strong recommendations, by the certainty of the evidence
      behind each one.
    </caption>
    <thead>
      <tr>
        <th scope="col" colspan="2">Certainty</th>
        <th scope="col" class="num">Count</th>
        <th scope="col" class="num">Share</th>
      </tr>
    </thead>
    {
      grouped.map((group) => (
        <tbody>
          <tr class="group">
            <td class="swatch-cell">
              <span class:list={["unit", group.id]} />
            </td>
            <th scope="rowgroup">
              {group.label} <span class="note">({group.note})</span>
            </th>
            <td class="num total">{group.count}</td>
            <td class="num total">{share(group.count)}</td>
          </tr>
          {group.rows.length > 1 && group.rows.map((row) => (
            <tr class="detail">
              <td />
              <th scope="row">{row.certainty}</th>
              <td class="num">{row.count}</td>
              <td class="num">{row.percent}%</td>
            </tr>
          ))}
        </tbody>
      ))
    }
  </table>

  <figcaption>
    <p>
      One square per strong recommendation, {data.strong} of them, shaded by how
      much evidence stands behind it. From <a href={data._source.url}
        >{data._source.dataset}</a
      >. {data._source.publisher}. Used under <a href={data._source.licence_url}
        >{data._source.licence}</a
      >.
    </p>
  </figcaption>
</figure>

<style>
  .certainty {
    margin-block: var(--at-spacing-lg);
    margin-inline: 0;
  }

  /* Full width, matching the table below it, because a narrower block above a
     full width table reads as an accident rather than a choice.
     A fixed column count rather than auto-fill, because a waffle is read as a
     block and a reflowing one changes shape as the window moves. The count
     rises with the width instead of the squares growing, so a unit stays about
     22px at every size and the block gets shorter rather than chunkier.
     151 is prime, so the last row is short whatever is chosen; that is the
     exact count showing, not a defect. 35 leaves 11 in the last row, 25 leaves
     1, which would look like a mistake. */
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 35), 1fr);
    gap: 2px;
  }

  .unit {
    aspect-ratio: 1;
    border-radius: 1px;
  }

  /* One hue, stepped by lightness, so density means support. The two filled
     steps sit at deltaE 16 from each other and from the surface; the third
     state is the absence of fill, which is a shape difference and therefore
     survives greyscale, print and forced colours. */
  .unit.backed {
    background: var(--at-primary);
  }

  .unit.weak {
    background: color-mix(in srgb, var(--at-primary) 28%, transparent);
  }

  .unit.none {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--at-border);
  }

  table {
    width: 100%;
    margin-block-start: var(--at-spacing-md);
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The theme paints table headers with the brand colour and stripes body rows.
     Reset `thead` itself and not only `thead th`: transparent cells let an
     ancestor's paint straight through, which cost a round of "fixed" on the UV
     table while the bar was still visibly gold on screen. */
  .certainty thead,
  .certainty thead th,
  .certainty tbody tr,
  .certainty tbody th {
    background: transparent;
  }

  th,
  td {
    padding: 0.3rem 0.5rem;
    text-align: start;
    font-weight: 400;
    vertical-align: baseline;
  }

  thead th {
    color: var(--at-text-secondary);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-block-end: 1px solid var(--at-border);
  }

  .swatch-cell {
    width: 1.5rem;
    padding-inline-end: 0;
  }

  /* The swatch has to be big enough to read as the same mark as a grid square
     without being so big it reads as a button. */
  .swatch-cell .unit {
    display: block;
    width: 0.8rem;
    height: 0.8rem;
  }

  .group th {
    font-size: 0.95rem;
  }

  .group .total {
    font-weight: 600;
  }

  .note {
    color: var(--at-text-secondary);
    font-size: 0.8rem;
  }

  /* The five published categories, indented under the state they map to, so the
     grouping is visibly an interpretation of the source rather than the
     source's own shape. Suppressed where a state maps to a single category,
     because "There is no evidence (no studies included) 18" followed by "No
     studies 18" is the same row twice. */
  .detail th {
    padding-inline-start: var(--at-spacing-sm);
    color: var(--at-text-secondary);
    font-size: 0.85rem;
  }

  .detail td {
    color: var(--at-text-secondary);
    font-size: 0.85rem;
  }

  .num {
    text-align: end;
    white-space: nowrap;
  }

  figcaption {
    margin-block-start: var(--at-spacing-md);
    color: var(--at-text-secondary);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  figcaption p {
    margin-block: 0;
  }

  @media (width < 52rem) {
    .grid {
      --cols: 26;
    }
  }

  @media (width < 34rem) {
    .grid {
      --cols: 15;
    }
  }
</style>
